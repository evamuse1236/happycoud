{
  "name": "happycoud",
  "version": "4.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite --host 127.0.0.1 --port 4317 --strictPort",
    "sync": "node scripts/comments.mjs",
    "build": "npm run sync && vite build",
    "preview": "vite preview --host 127.0.0.1 --port 4317 --strictPort",
    "test": "node --test scripts/comments.test.mjs tests/*.test.mjs",
    "build:standalone": "node tools/build.mjs",
    "refine": "node tools/refine.mjs",
    "refine:watch": "node tools/refine.mjs --watch",
    "refine:full": "node tools/refine.mjs --browser --shaders"
  },
  "dependencies": {
    "@fontsource/bricolage-grotesque": "^5.3.0",
    "@fontsource/cormorant-garamond": "^5.3.0",
    "@fontsource/dm-sans": "^5.3.0",
    "three": "^0.186.0",
    "vite": "^8.3.0"
  }
}
